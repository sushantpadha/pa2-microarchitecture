#include "cache.h"
#include <cstdlib>

#define maxRRPV 3
// L2C_WAY == 8 in cache.h
uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t l2_instr[L2C_SET][L2C_WAY];
uint32_t code_max;  // max number of code lines to keep to limit (didnt help MPKI but helped speedup a lot)
uint32_t age_k;     // instr lines age once every age_k rounds (2, or 4 for lvl 6 8)
uint32_t data_ins;  // insertion RRPV for data lines (maxRRPV-1, or maxRRPV for lvl 7 8)
int lvl;

// LVL (from env) picks the ideas for experiments. default is 8, so please add `lvl==8 ||` for anything you want to submit
// lvl 1: evict data first, age instr 2x slower, insert everything at maxRRPV-1, promote data as rrpv--
// lvl 2: lvl 1, but insert instr at 0
// lvl 3: lvl 1, plus cap instr lines per set at code_max -- tends to hurt L2_ins_MPKI but improve speedup massively
// lvl 4: lvl 2, but promote data to 1
// lvl 5: lvl 1, but promote data to 1
// lvl 6: lvl 1, but age instr 4x slower
// lvl 7: lvl 1, but insert data at maxRRPV: unreused data is evicted before any instr ages
// lvl 8: default. lvl 6 + lvl 7

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    const char *s = getenv("IRRIP_CODE_MAX");
    code_max = s ? atoi(s) : 6;
    s = getenv("LVL");
    lvl = s ? atoi(s) : 8;
    // # 6 8 - age instr 4x slower; # 7 8 - insert data at maxRRPV
    age_k = (lvl == 6 || lvl == 8) ? 4 : 2;
    data_ins = (lvl == 7 || lvl == 8) ? maxRRPV : maxRRPV-1;
    cout << "Initialize I-RRIP state for L2C, lvl " << lvl << ", code_max " << code_max << ", age_k " << age_k << ", data_ins " << data_ins << endl;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            l2_instr[i][j] = 0;
        }
    }

}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // # 3 - evict instr line if >= code_max
    uint32_t ncode = 0;
    for (int i=0; i<L2C_WAY; i++)
        ncode += l2_instr[set][i];
    if ((lvl == 3) && ncode > 0 && ncode >= code_max) {
        int v = -1;
        for (int i=0; i<L2C_WAY; i++)
            if (l2_instr[set][i] && (v < 0 || l2_rrpv[set][i] > l2_rrpv[set][v]))
                v = i;
        return v;
    }

    // # 1-8 - evict data first
    // # 1-8 - age instr lines once every age_k rounds
    uint32_t round = 0;
    while (1) {
        if (lvl == 1 || lvl == 2 || lvl == 3 || lvl == 4 || lvl == 5 || lvl == 6 || lvl == 7 || lvl == 8)
            for (int i=0; i<L2C_WAY; i++)
                if (!l2_instr[set][i] && l2_rrpv[set][i] == maxRRPV)
                    return i;

        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for (int i=0; i<L2C_WAY; i++)
            if (!((lvl==1 || lvl==2 || lvl==3 || lvl==4 || lvl==5 || lvl==6 || lvl==7 || lvl==8) && (round%age_k != age_k-1) && l2_instr[set][i]))
                l2_rrpv[set][i]++;
        
        round++;
    }

    // // look for the maxRRPV line
    // while (1)
    // {
    //     for (int i=0; i<L2C_WAY; i++)
    //         if (l2_rrpv[set][i] == maxRRPV)
    //             return i;

    //     for (int i=0; i<L2C_WAY; i++)
    //         l2_rrpv[set][i]++;
    // }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    // ! for instruction
    if (!hit) {
        // insert
        l2_instr[set][way] = isInstruction;

        // # 2 4 - insert instruction at 0
        // # 1 3 5 6 7 8 - insert instr at maxRRPV-1 (the else branch): instr must be reused once to reach 0; data at data_ins
        if ((lvl == 2 || lvl == 4) && isInstruction)
            l2_rrpv[set][way] = 0;  // insert instruction
        else
            l2_rrpv[set][way] = isInstruction ? maxRRPV-1 : data_ins;
    } else {
        // promote
        if (isInstruction)
            l2_rrpv[set][way] = 0;
        else if (lvl == 4 || lvl == 5)
            // # 4 5 - promote data to 1, just behind instructions
            l2_rrpv[set][way] = 1;
        else if (lvl == 1 || lvl == 2 || lvl == 3 || lvl == 6 || lvl == 7 || lvl == 8)
            // # 1 2 3 6 7 8 - promote data: decrement RRPV instead of setting 0
            l2_rrpv[set][way] = (l2_rrpv[set][way]==0 ? 0 : l2_rrpv[set][way]-1);
        else
            l2_rrpv[set][way] = 0;
    }

}

