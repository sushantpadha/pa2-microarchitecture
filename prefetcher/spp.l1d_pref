// Stride Pattern Prefetcher (SPP) at the L1D.
//
// Each load IP that misses in the L1D gets an entry in the IP table; tracked IPs
// then train on every load. For every new cache-line stride an IP produces, two
// predictors are trained side by side:
//   - uniform: "the next stride equals the last one" (classic IP-stride);
//   - pattern: a signature of the IP's last few strides indexes a shared
//     pattern table that holds the stride that followed that signature last
//     time. This captures repeating sequences such as (+1,+2,+2,+2,+3)^n.
// A per-IP saturating chooser counts which predictor was right. It starts at
// "uniform" (uniform strides have priority) and moves to "pattern" only when
// the pattern table keeps being right where the uniform predictor is wrong.
//
// Prefetches walk ahead `degree` steps along the chosen prediction and never
// leave the 4 KB page of the triggering access. A small recent-prefetch filter
// (RPF) remembers the lines requested recently. It drops duplicate requests and
// doubles as the accuracy checker:
//   - a prefetch counts once it fills the L1D (the line was not there yet);
//   - it is useful if a demand load reaches the line while it is still in the RPF;
//   - a demand that misses on a requested line that has not filled yet is a
//     late (or L2-only) prefetch: correct, so it counts as issued and useful;
//   - a demand that hits on a requested line that never filled means the line
//     was already cached: the prefetch was redundant and is not counted.
// Every EPOCH counted prefetches, the global degree steps up if accuracy >= THI
// and down if accuracy < TLO. Limitation: a prefetch that fills only the L2
// (sent when half the L1D MSHRs are busy) is counted only if a demand reaches
// it, so unused ones of that kind are invisible to the throttle.
//
// Knobs (environment variables, read once; the defaults are the final values):
//   SPP_TLO, SPP_THI   accuracy thresholds for stepping the degree down / up
//   SPP_DMAX           largest degree
//   SPP_IPT_SET_BITS   log2 of the IP table sets
//   SPP_IPT_WAYS       IP table ways
// Storage is itemised in l1d_prefetcher_final_stats().

#include "cache.h"
#include <cstdlib>
#include <vector>

// ---- sizes -----------------------------------------------------------------
// Independent parameters. Everything else below is derived from these.
// The IP table's sets and ways are knobs (IPT_SET_BITS, IPT_WAYS, below).
#define IPT_ID_BITS   16          // hashed-IP bits that identify an IP: set index + tag
#define LINE_BITS     16          // low bits of the last line address kept per IP
#define SIG_BITS      9          // stride-history signature
#define SIG_SHIFT     3
#define PT_BITS       9          // pattern table index, from the folded signature
#define RPF_BITS      8           // recent-prefetch filter index, direct mapped
#define RPF_TAG_BITS  10
#define EPOCH         256         // issued prefetches per accuracy evaluation
#define DMIN          1
#define DMAX_LIMIT    16          // largest SPP_DMAX accepted
#define CONF_MAX      3           // saturating confidence counters
#define USE_CONF      2           // confidence needed before a prediction is used
#define CHOOSER_MAX   3           // upper half: prefer uniform, lower half: prefer pattern

// Derived.
#define PT_ENTRIES    (1 << PT_BITS)
#define RPF_ENTRIES   (1 << RPF_BITS)
#define STRIDE_MAX    ((1 << (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE)) - 1) // |stride| in lines; larger strides always leave the page
#define STRIDE_BITS   (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE + 1)          // signed, holds +-STRIDE_MAX
#define CHOOSER_UNI   ((CHOOSER_MAX + 1) / 2)                         // chooser >= this: prefer uniform

// Bits needed to hold 0..n.
static constexpr int bits_for(unsigned n) { return n ? 1 + bits_for(n >> 1) : 0; }

static_assert(IPT_ID_BITS <= 32, "the IP hash is 32 bits");
static_assert(LINE_BITS > STRIDE_BITS, "an in-page stride must fit in the kept line bits");
static_assert(SIG_BITS <= 2 * PT_BITS, "pt_index folds the signature once");

struct IPEntry {
    bool     valid = false;
    uint32_t tag = 0;             // IPT_ID_BITS - IPT_SET_BITS of the hashed IP
    uint32_t last_line = 0;       // LINE_BITS of the last line address
    int32_t  last_stride = 0;     // STRIDE_BITS signed, 0 = none yet
    uint32_t conf = 0;            // uniform confidence, 0..CONF_MAX
    uint32_t sig = 0;             // SIG_BITS stride history
    uint32_t chooser = CHOOSER_MAX; // 0..CHOOSER_MAX, start on "uniform"
    uint32_t lru = 0;             // 0..IPT_WAYS-1, 0 = most recent
}; // 32 + 24 + LOG2_IPT_WAYS - IPT_SET_BITS

struct PTEntry {
    int32_t  stride = 0;          // STRIDE_BITS signed, 0 = empty
    uint32_t conf = 0;            // 0..CONF_MAX
};

struct RPFEntry {
    bool     valid = false;
    uint32_t tag = 0;             // RPF_TAG_BITS of the line address
    bool     filled = false;      // the prefetch has filled the L1D
    uint8_t  cls = 0;             // 0 uniform, 1 pattern (statistics only, not counted as storage)
};

static std::vector<IPEntry> ipt; // IPT sets x IPT_WAYS, sized at initialization
static PTEntry  pt[PT_ENTRIES];
static RPFEntry rpf[RPF_ENTRIES];

// Throttling state: two epoch counters (0..EPOCH) and the current degree.
static uint32_t epoch_issued = 0, epoch_useful = 0;
static uint32_t degree = 4;

static double   TLO = 0.50, THI = 0.75;
static uint32_t DMAX = 8;
static uint32_t IPT_SET_BITS = 5, IPT_WAYS = 4; // 32 sets x 4 ways = 128 IPs
static uint32_t DISTANCE = 0;

// Statistics only (not hardware), counted after warmup.
static uint64_t st_sent = 0, st_dup = 0, st_pq_full = 0, st_page_stop = 0, st_epochs = 0,
                st_redundant = 0;
static uint64_t st_cand[2] = {0}, st_fill[2] = {0}, st_timely[2] = {0}, st_late[2] = {0};
static uint64_t st_degree_epochs[DMAX_LIMIT + 1] = {0};

static double env_or(const char *name, double dflt)
{
    const char *v = getenv(name);
    return v ? atof(v) : dflt;
}

static uint32_t sig_update(uint32_t sig, int32_t stride)
{
    // STRIDE_BITS two's complement stride, shifted into the history.
    return ((sig << SIG_SHIFT) ^ (uint32_t)(stride & ((1 << STRIDE_BITS) - 1))) & ((1u << SIG_BITS) - 1);
}

static uint32_t pt_index(uint32_t sig)
{
    // Fold the SIG_BITS signature into PT_BITS.
    return sig;
}

static uint32_t ip_hash(uint64_t ip)
{
    return (uint32_t)(ip ^ (ip >> 4) ^ (ip >> 14));
}

// ---- recent-prefetch filter ------------------------------------------------
static uint32_t rpf_index(uint64_t line) { return line & (RPF_ENTRIES - 1); }
static uint32_t rpf_tag(uint64_t line)   { return (line >> RPF_BITS) & ((1u << RPF_TAG_BITS) - 1); }

static bool rpf_hit(uint64_t line)
{
    RPFEntry &e = rpf[rpf_index(line)];
    return e.valid && e.tag == rpf_tag(line);
}

// ---- throttling --------------------------------------------------------------
static void end_epoch();

// One prefetch whose outcome counts toward accuracy.
static void count(bool useful)
{
    // Saturate at EPOCH: a timely use can be credited in the epoch after its
    // fill, so useful can run ahead of issued. Any value >= EPOCH already
    // means accuracy >= 1, so saturating never changes a decision, and the
    // counter fits in bits_for(EPOCH) bits.
    if (useful && epoch_useful < EPOCH)
        epoch_useful++;
    if (++epoch_issued == EPOCH)
        end_epoch();
}

static void end_epoch()
{
    double acc = (double)epoch_useful / epoch_issued;
    if (acc >= THI && degree < DMAX)
        degree++;
    else if (acc < TLO && degree > DMIN)
        degree--;
    epoch_issued = epoch_useful = 0;
    if (warmup_complete[0]) {
        st_epochs++;
        st_degree_epochs[degree]++;
    }
}

void CACHE::l1d_prefetcher_initialize()
{
    TLO  = env_or("SPP_TLO", TLO);
    THI  = env_or("SPP_THI", THI);
    DISTANCE  = env_or("DISTANCE", DISTANCE);
    DMAX = (uint32_t)env_or("SPP_DMAX", DMAX);
    if (DMAX < DMIN) DMAX = DMIN;
    if (DMAX > DMAX_LIMIT) DMAX = DMAX_LIMIT;
    if (degree > DMAX) degree = DMAX;

    IPT_SET_BITS = (uint32_t)env_or("SPP_IPT_SET_BITS", IPT_SET_BITS);
    IPT_WAYS     = (uint32_t)env_or("SPP_IPT_WAYS", IPT_WAYS);
    if (IPT_SET_BITS > IPT_ID_BITS) IPT_SET_BITS = IPT_ID_BITS;
    if (IPT_WAYS < 1) IPT_WAYS = 1;
    ipt.assign((size_t)IPT_WAYS << IPT_SET_BITS, IPEntry());
    for (size_t i = 0; i < ipt.size(); i++)
        ipt[i].lru = i % IPT_WAYS;

    std::cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (SPP)"
              << " TLO " << TLO << " THI " << THI << " DMAX " << DMAX
              << " IPT_SET_BITS " << IPT_SET_BITS << " IPT_WAYS " << IPT_WAYS << std::endl;
}

// Issue one prefetch for a line in the trigger's page. Returns false when the
// PQ is full, so the caller stops walking.
static bool issue(CACHE *c, uint64_t ip, uint64_t addr, uint64_t line, uint8_t cls)
{
    if (rpf_hit(line)) {          // already prefetched recently
        if (warmup_complete[c->cpu]) st_dup++;
        return true;
    }
    int fill = (c->MSHR.occupancy < (c->MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
    if (!c->prefetch_line(ip, addr, line << LOG2_BLOCK_SIZE, fill, 0)) {
        if (warmup_complete[c->cpu]) st_pq_full++;
        return false;
    }
    RPFEntry &e = rpf[rpf_index(line)];
    e.valid = true;
    e.tag = rpf_tag(line);
    e.filled = false;
    e.cls = cls;
    if (warmup_complete[c->cpu]) st_sent++;
    return true;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    if (type != LOAD)
        return;

    uint64_t line = addr >> LOG2_BLOCK_SIZE;
    uint64_t page = addr >> LOG2_PAGE_SIZE;

    // Accuracy check: a demand load to a recently prefetched line. Each
    // prefetch is judged once, then dropped from the RPF.
    RPFEntry &r = rpf[rpf_index(line)];
    if (r.valid && r.tag == rpf_tag(line)) {
        bool warm = warmup_complete[cpu];
        r.valid = false;
        if (r.filled) {               // timely: counted as issued at fill time
            if (warm) st_timely[r.cls]++;
            if (epoch_useful < EPOCH) // the fill already counted it as issued
                epoch_useful++;
        } else if (!cache_hit) {      // late, or filled only the L2
            if (warm) st_late[r.cls]++;
            count(true);
        } else {                      // the line was already cached: redundant
            if (warm) st_redundant++;
        }
    }

    // ---- IP table lookup (set associative, LRU) ----
    uint32_t h = ip_hash(ip);
    uint32_t set = h & ((1u << IPT_SET_BITS) - 1);
    uint32_t tag = (uint32_t)(((uint64_t)h >> IPT_SET_BITS) & ((1ull << (IPT_ID_BITS - IPT_SET_BITS)) - 1));
    IPEntry *ways = &ipt[(size_t)set * IPT_WAYS];
    int w = -1;
    for (int i = 0; i < (int)IPT_WAYS; i++)
        if (ways[i].valid && ways[i].tag == tag) { w = i; break; }

    auto touch = [&](int way) {
        for (int i = 0; i < (int)IPT_WAYS; i++)
            if (ways[i].lru < ways[way].lru) ways[i].lru++;
        ways[way].lru = 0;
    };

    uint32_t cur_line = line & ((1u << LINE_BITS) - 1);

    if (w < 0) {
        // New IP. Allocate only on an L1D miss: the traces have over 100K
        // distinct load IPs, most of which always hit and never need a
        // prefetcher; allocating them would evict the IPs that do.
        if (cache_hit)
            return;
        // Replace the LRU way; nothing to predict yet.
        for (int i = 0; i < (int)IPT_WAYS; i++)
            if (ways[i].lru == IPT_WAYS - 1) { w = i; break; }
        ways[w] = IPEntry();
        ways[w].valid = true;
        ways[w].tag = tag;
        ways[w].last_line = cur_line;
        ways[w].lru = IPT_WAYS - 1;
        touch(w);
        return;
    }
    IPEntry &e = ways[w];
    touch(w);

    // Stride in lines, from the LINE_BITS kept per IP (sign-extended).
    int32_t stride = (int32_t)((cur_line - e.last_line) & ((1u << LINE_BITS) - 1));
    if (stride >= (1 << (LINE_BITS - 1)))
        stride -= (1 << LINE_BITS);
    if (stride == 0)              // same line again: no new information
        return;
    e.last_line = cur_line;

    if (stride > STRIDE_MAX || stride < -STRIDE_MAX) {
        // A jump that leaves the page (new array, new object): the history
        // before it does not predict what comes after it.
        e.last_stride = 0;
        e.conf = 0;
        e.sig = 0;
        return;
    }

    // ---- train ----
    PTEntry &p = pt[pt_index(e.sig)];
    bool uni_right = e.last_stride != 0 && e.last_stride == stride;
    bool pat_right = p.conf > 0 && p.stride == stride;

    // Chooser: move only when exactly one predictor was right.
    if (uni_right && !pat_right && e.chooser < CHOOSER_MAX) e.chooser++;
    if (pat_right && !uni_right && e.chooser > 0)           e.chooser--;

    // Uniform confidence: up on a repeat, down otherwise; replace at zero.
    if (uni_right) {
        if (e.conf < CONF_MAX) e.conf++;
    } else if (e.conf > 0) {
        e.conf--;
    }
    if (e.conf == 0)
        e.last_stride = stride;

    // Pattern table: same rule, keyed by the history that preceded `stride`.
    if (e.sig != 0) {
        if (p.conf > 0 && p.stride == stride) {
            if (p.conf < CONF_MAX) p.conf++;
        } else if (p.conf > 0) {
            p.conf--;
        } else {
            p.stride = stride;
            p.conf = 1;
        }
    }
    e.sig = sig_update(e.sig, stride);

    // ---- predict ----
    bool uni_ok = e.conf >= USE_CONF;
    PTEntry &q = pt[pt_index(e.sig)];
    bool pat_ok = q.conf >= USE_CONF;
    bool use_uniform = uni_ok && (e.chooser >= CHOOSER_UNI || !pat_ok);
    bool use_pattern = !use_uniform && pat_ok;

    int64_t pf_line = line;
    if (use_uniform) {
        for (uint32_t k = 0; k < degree+DISTANCE; k++) {
            pf_line += e.last_stride;
            if ((uint64_t)pf_line >> (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE) != page) { if (warmup_complete[cpu]) st_page_stop++; break; }
            if (warmup_complete[cpu]) st_cand[0]++;
            if (k >= DISTANCE && !issue(this, ip, addr, pf_line, 0)) break;
        }
    } else if (use_pattern) {
        // Walk the pattern table ahead: each predicted stride extends a
        // speculative signature that indexes the next step.
        uint32_t s = e.sig;
        for (uint32_t k = 0; k < degree+DISTANCE; k++) {
            PTEntry &n = pt[pt_index(s)];
            if (n.conf < USE_CONF) break;
            pf_line += n.stride;
            if ((uint64_t)pf_line >> (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE) != page) { if (warmup_complete[cpu]) st_page_stop++; break; }
            if (warmup_complete[cpu]) st_cand[1]++;
            if (k >= DISTANCE && !issue(this, ip, addr, pf_line, 1)) break;
            s = sig_update(s, n.stride);
        }
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
    // A prefetch filled the L1D: it was needed there, so it counts toward
    // accuracy, as useless until a demand load proves otherwise.
    if (!prefetch)
        return;
    uint64_t line = v_addr >> LOG2_BLOCK_SIZE;
    RPFEntry &r = rpf[rpf_index(line)];
    if (r.valid && r.tag == rpf_tag(line) && !r.filled) {
        r.filled = true;
        if (warmup_complete[cpu]) st_fill[r.cls]++;
        count(false);
    }
}

void CACHE::l1d_prefetcher_final_stats()
{
    // Storage (bits), from the field widths above.
    const int ipt_entry = 1 /*valid*/ + (IPT_ID_BITS - IPT_SET_BITS) /*tag*/ + LINE_BITS
                        + STRIDE_BITS + bits_for(CONF_MAX) + SIG_BITS + bits_for(CHOOSER_MAX)
                        + bits_for(IPT_WAYS - 1) /*lru*/;
    const int pt_entry  = STRIDE_BITS + bits_for(CONF_MAX);
    const int rpf_entry = 1 /*valid*/ + RPF_TAG_BITS + 1 /*filled*/;
    const int ctrl      = 2 * bits_for(EPOCH) /*issued, useful*/ + bits_for(DMAX) /*degree*/;
    const int ipt_n     = (int)ipt.size();
    const int total = ipt_n * ipt_entry + PT_ENTRIES * pt_entry + RPF_ENTRIES * rpf_entry + ctrl;

    std::cout << "CPU " << cpu << " L1D SPP final stats" << std::endl;
    std::cout << "SPP storage bits: IPT " << ipt_n << "x" << ipt_entry
              << " PT " << PT_ENTRIES << "x" << pt_entry
              << " RPF " << RPF_ENTRIES << "x" << rpf_entry
              << " ctrl " << ctrl << " total " << total << " (" << total / 8.0 << " bytes)" << std::endl;
    uint64_t fills = st_fill[0] + st_fill[1], late = st_late[0] + st_late[1];
    uint64_t useful = st_timely[0] + st_timely[1] + late;
    std::cout << "SPP sent: " << st_sent << " duplicate: " << st_dup << " pq_full: " << st_pq_full
              << " page_stop: " << st_page_stop << " redundant: " << st_redundant << std::endl;
    std::cout << "SPP issued: " << fills + late << " useful: " << useful
              << " accuracy: " << (fills + late ? 100.0 * useful / (fills + late) : 0) << std::endl;
    const char *name[2] = {"uniform", "pattern"};
    for (int c = 0; c < 2; c++)
        std::cout << "SPP " << name[c] << " candidates: " << st_cand[c] << " fills: " << st_fill[c]
                  << " timely: " << st_timely[c] << " late: " << st_late[c]
                  << " accuracy: " << (st_fill[c] + st_late[c] ? 100.0 * (st_timely[c] + st_late[c]) / (st_fill[c] + st_late[c]) : 0)
                  << std::endl;
    std::cout << "SPP final degree: " << degree << " epochs: " << st_epochs << " degree histogram:";
    for (uint32_t d = DMIN; d <= DMAX; d++)
        std::cout << " " << d << ":" << st_degree_epochs[d];
    std::cout << std::endl;
}
