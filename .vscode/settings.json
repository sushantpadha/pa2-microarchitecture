{
    // LaTeX Workshop: every save runs `make -C report`, the same build as the
    // command line, so Summary.pdf and report/build/report.pdf both update.
    // Section files carry "% !TEX root = ../report.tex", so saving a section
    // rebuilds the whole report. View it with "LaTeX Workshop: View LaTeX PDF"
    // (report/build/report.pdf); that tab refreshes after each build.
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.search.rootFiles.include": ["report/report.tex"],
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.auxDir": "%DIR%/build",
    "latex-workshop.latex.recipes": [
        { "name": "make (PA2 summary)", "tools": ["make-summary"] }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.tools": [
        {
            "name": "make-summary",
            "command": "make",
            "args": ["-C", "%DIR%"]
        }
    ],
    "latex-workshop.view.pdf.viewer": "tab",
    "files.associations": {
        "*.*_repl": "cpp",
        "*.l2c_repl": "cpp",
        "bitset": "cpp",
        "set": "cpp"
    }
}
