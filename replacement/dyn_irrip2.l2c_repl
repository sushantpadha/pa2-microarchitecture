#include "cache.h"
#include <cstdlib>

// Dynamic I-RRIP with a choice of decision signal (DYN_SIGNAL):
// 0: the hint ratio r = (instr acc + instr miss) / (acc + miss) in the RRIP
//    leaders; followers run I-RRIP if r > T (same as dyn_irrip.l2c_repl).
// 1: set dueling. A second leader group always runs I-RRIP. Both groups count
//    demand misses, instruction misses weighted by W. Followers take the policy
//    with the lower weighted misses per access.
//    Why W > 1: an L2 instruction miss stalls fetch, so its full latency is
//    exposed; a data miss overlaps with other work and other misses (OoO, MLP).

#define maxRRPV 3
// L2C_WAY == 8, L2C_SET == 1024 in cache.h
uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t l2_instr[L2C_SET][L2C_WAY];  // set on every fill, in every set and mode
uint8_t l2_leader[L2C_SET];          // 0 follower, 1 always RRIP, 2 always I-RRIP (signal 1)

double thresh, hyst, imiss_w;
uint32_t n_leaders, epoch, place, dyn_signal;
uint32_t n_ia, n_im, n_ta, n_tm;  // RRIP leaders: instr accesses, instr misses, total accesses, total misses
uint32_t n_im2, n_ta2, n_tm2;     // I-RRIP leaders (signal 1): instr misses, total accesses, total misses
uint32_t epoch_left;
uint8_t irrip_mode = 1;   // followers start in I-RRIP

// DYN_LOG=1 prints one line per decision (off by default): whether warmup is
// over, r, and the mode chosen.
// With signal 1, r is the I-RRIP leaders' weighted miss rate over the RRIP leaders'.
int dyn_log;

// stats
uint64_t n_epochs, n_irrip_epochs;
double ratio_min = 1e9, ratio_max = 0, ratio_sum;

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    const char *s;
    dyn_signal = (s = getenv("DYN_SIGNAL"))   ? atoi(s) : 1;
    imiss_w    = (s = getenv("DYN_IMISS_W"))  ? atof(s) : 4;
    thresh     = (s = getenv("DYN_THRESH"))   ? atof(s) : 0.15;
    hyst       = (s = getenv("DYN_HYST"))     ? atof(s) : 0.05;
    n_leaders  = (s = getenv("DYN_LEADERS"))  ? atoi(s) : 16;
    epoch      = (s = getenv("DYN_EPOCH"))    ? atoi(s) : 1024;
    place      = (s = getenv("DYN_PLACE"))    ? atoi(s) : 0;
    dyn_log    = (s = getenv("DYN_LOG"))      ? atoi(s) : 0;
    epoch_left = epoch;

    // Leader placement: fix k index bits; L2C_SET / 2^k leaders per group
    // set index: 15-6; block offset: 5-0
    // can either use top k bits or bottom k or combination

    // place 0: low k index bits equal the next k bits (I-RRIP group: their complement)
    // place 1: low k index bits are 0 (I-RRIP group: all 1)
    // place 2: the first n_leaders sets (I-RRIP group: the next n_leaders)
    // k >= 1, so the two groups never overlap
    uint32_t k = 0;
    while ((L2C_SET >> k) > n_leaders)
        k++;
    uint32_t m = (1 << k) - 1, count = 0, count2 = 0;
    for (int i=0; i<L2C_SET; i++) {
        uint8_t rrip_l, irrip_l;
        if (place == 1) {
            rrip_l  = ((i & m) == 0);
            irrip_l = ((i & m) == m);
        } else if (place == 2) {
            rrip_l  = (i < n_leaders);
            irrip_l = (i >= n_leaders && i < 2*n_leaders);
        } else {
            rrip_l  = ((i & m) == ((i >> k) & m));
            irrip_l = ((i & m) == ((~i >> k) & m));
        }
        l2_leader[i] = rrip_l ? 1 : (dyn_signal && irrip_l) ? 2 : 0;
        count  += (l2_leader[i] == 1);
        count2 += (l2_leader[i] == 2);
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            l2_instr[i][j] = 0;
        }
    }
    cout << "Initialize Dynamic I-RRIP state for L2C, signal " << dyn_signal << ", imiss_w " << imiss_w
         << ", thresh " << thresh << ", hyst " << hyst << ", leaders " << count << " + " << count2
         << ", place " << place << ", epoch " << epoch << endl;
    assert(count == n_leaders);
    assert(count2 == (dyn_signal ? n_leaders : 0));
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    uint8_t irrip = (l2_leader[set] == 2) || (!l2_leader[set] && irrip_mode);

    // IRRIP vs RRIP
    uint32_t round = 0;
    while (1) {
        if (irrip)
            for (int i=0; i<L2C_WAY; i++)
                if (!l2_instr[set][i] && l2_rrpv[set][i] == maxRRPV)
                    return i;

        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for (int i=0; i<L2C_WAY; i++)
            if (!(irrip && (round%4 != 3) && l2_instr[set][i]))
                l2_rrpv[set][i]++;

        round++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
	TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
	TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
	TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    // count demand (non-WB and non-PF) traffic in I-RRIP leader sets
    if (l2_leader[set] == 2 && type != WRITEBACK && type != PREFETCH) {
        n_ta2++;
        if (!hit) { n_tm2++; n_im2 += isInstruction; }
    }

    // count demand (non-WB and non-PF) traffic in RRIP leader sets; an epoch is
    // DYN_EPOCH accesses to them
    if (l2_leader[set] == 1 && type != WRITEBACK && type != PREFETCH) {
        n_ta++; n_ia += isInstruction;
        if (!hit) { n_tm++; n_im += isInstruction; }
        if (--epoch_left == 0) {
            double ratio;
            if (dyn_signal) {
                // weighted misses per demand access, I-RRIP leaders over RRIP leaders
                double c_rrip  = (imiss_w * n_im  + (n_tm  - n_im))  / n_ta;
                double c_irrip = n_ta2 ? (imiss_w * n_im2 + (n_tm2 - n_im2)) / n_ta2 : 0;
                ratio = c_irrip / (c_rrip > 0 ? c_rrip : 1e-9);
                if (ratio < 1 - hyst)
                    irrip_mode = 1;
                else if (ratio > 1 + hyst)
                    irrip_mode = 0;
            } else {
                double num = n_ia + n_im, den = n_ta + n_tm;
                ratio = num / den;
                if (num > (thresh + hyst) * den)
                    irrip_mode = 1;
                else if (num <= (thresh - hyst) * den)
                    irrip_mode = 0;
            }
            n_ia /= 2; n_im /= 2; n_ta /= 2; n_tm /= 2;
            n_im2 /= 2; n_ta2 /= 2; n_tm2 /= 2;
            epoch_left = epoch;

            if (dyn_log)
                cout << "DYN_LOG roi " << (int)warmup_complete[cpu] << " r " << ratio
                     << " mode " << (int)irrip_mode << endl;

            // ! for stats
            if (warmup_complete[cpu]) {
                n_epochs++;
                n_irrip_epochs += irrip_mode;
                ratio_sum += ratio;
                ratio_min = min(ratio_min, ratio);
                ratio_max = max(ratio_max, ratio);
            }
        }
    }

    uint8_t irrip = (l2_leader[set] == 2) || (!l2_leader[set] && irrip_mode);

    if (!hit) {
        // insert at maxRRPV-1; I-RRIP inserts data at maxRRPV (lvl 8), so
        // unreused data is evicted before any instr line ages
        l2_instr[set][way] = isInstruction;
        l2_rrpv[set][way] = (irrip && !isInstruction) ? maxRRPV : maxRRPV-1;
    } else if (isInstruction || !irrip) {
        // promote instr hits (both modes) and all RRIP hits to 0
        l2_rrpv[set][way] = 0;
    } else {
        // irrip data hit: decrement RRPV instead of setting 0
        l2_rrpv[set][way] = (l2_rrpv[set][way]==0 ? 0 : l2_rrpv[set][way]-1);
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
}

// ! guarantees running at the end
// with signal 1, ratio_* is the I-RRIP / RRIP weighted miss rate (< 1: I-RRIP misses less)
struct DynStats {
    ~DynStats() {
        cout << "DYN_IRRIP epochs " << n_epochs << " irrip_frac " << (n_epochs ? (double)n_irrip_epochs / n_epochs : 0)
             << " ratio_min " << ratio_min << " ratio_mean " << (n_epochs ? ratio_sum / n_epochs : 0)
             << " ratio_max " << ratio_max << endl;
    }
} dyn_stats;
